# Copy to .env and fill in. Never commit .env.

# HTTP port the API listens on
PORT=8000

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://codex:codex@localhost:5432/codex?schema=public

# MongoDB (lesson templates and tutor sessions)
MONGO_URL=mongodb://localhost:27017

# MinIO (APK download and user media)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=codex

# Tutor service (code-x-ai), without a trailing slash
TUTOR_URL=http://localhost:8001
