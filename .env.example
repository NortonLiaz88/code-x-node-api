# Copy to .env and fill in. Never commit .env.

# HTTP port the API listens on
PORT=8000

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=
# Separate secret for refresh tokens; must differ from JWT_SECRET_KEY
JWT_REFRESH_SECRET_KEY=

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://codex:codex@localhost:5432/codex?schema=public

# MongoDB: lesson templates live in the "db" database, tutor chat sessions
# in TUTOR_SESSIONS_DB, which must match the database code-x-ai writes to
MONGO_URL=mongodb://localhost:27017
TUTOR_SESSIONS_DB=codex

# MinIO (APK download and user media)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=codex

# Tutor service (code-x-ai), without a trailing slash
TUTOR_URL=http://localhost:8001

# Compose only: which model the tutor uses (passed to code-x-ai). With
# ollama, compose pulls LLM_MODEL on first start.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

# Optional: password for the seeded demo users (default codex123)
SEED_PASSWORD=
