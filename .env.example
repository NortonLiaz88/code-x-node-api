# Copy to .env and fill in. Never commit .env.

# HTTP port the API listens on
PORT=8000

# docker compose only: address the API port is published on. 127.0.0.1 keeps
# it on this machine; 0.0.0.0 lets phones on your Wi-Fi reach it.
# API_BIND=0.0.0.0

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=
# Separate secret for refresh tokens; must differ from JWT_SECRET_KEY
JWT_REFRESH_SECRET_KEY=

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://codex:codex@localhost:5432/codex?schema=public

# MongoDB: lesson templates live in the "db" database, tutor chat sessions
# in TUTOR_SESSIONS_DB, which must match the database code-x-ai writes to
MONGO_URL=mongodb://localhost:27017
TUTOR_SESSIONS_DB=codex

# MinIO (APK download and user media)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=codex

# Tutor service (code-x-ai), without a trailing slash
TUTOR_URL=http://localhost:8001
# Optional: how long to wait for the tutor before answering 503, in ms
# (default 120000). For streamed answers it's the longest silence allowed.
# TUTOR_TIMEOUT_MS=120000

# Email. With SMTP_URL set, mail goes out over SMTP (compose sets it to its
# Mailpit catcher); without it, emails are written to the API log.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=CodeX <no-reply@example.com>
# Password reset links: what the app opens, and minutes before they expire
# RESET_PASSWORD_URL=codex://reset-password
# RESET_TOKEN_TTL_MINUTES=30

# Compose only: which model the tutor uses (passed to code-x-ai). With
# ollama, compose pulls LLM_MODEL on first start.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

# Optional: password for the seeded demo users (default codex123)
SEED_PASSWORD=
